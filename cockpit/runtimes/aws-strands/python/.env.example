# Model configuration — Strands' native OpenAI provider. Plain OpenAI API
# key; NO AWS credentials are needed anywhere in this example.
# Placeholder values only — never commit real keys.
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional: redirect the OpenAI client (the aimock e2e harness sets this to
# replay fixtures instead of calling the live API).
# OPENAI_BASE_URL=http://localhost:portnum/v1

# Strands wires OpenTelemetry unconditionally; without a collector it logs
# exporter noise on every run. src/agent.py setdefaults both of these to
# disabled — set them here only to override that default.
OTEL_SDK_DISABLED=true
OTEL_PYTHON_DISABLED_INSTRUMENTATIONS=all
