{
  "name": "workspace-react",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/workspace-react/src",
  "projectType": "library",
  "tags": ["scope:cockpit", "scope:shared", "type:lib"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "dependsOn": ["^build"],
      "outputs": ["{workspaceRoot}/dist/libs/workspace-react"],
      "options": {
        "outputPath": "dist/libs/workspace-react",
        "main": "libs/workspace-react/src/index.ts",
        "tsConfig": "libs/workspace-react/tsconfig.lib.json",
        "assets": [
          {
            "input": "libs/workspace-react/src/styles",
            "glob": "*.css",
            "output": "src/styles"
          }
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "libs/workspace-react/vite.config.mts"
      }
    }
  }
}
