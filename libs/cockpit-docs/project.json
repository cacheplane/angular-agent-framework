{
  "name": "cockpit-docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/cockpit-docs/src",
  "projectType": "library",
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "{workspaceRoot}/dist/libs/cockpit-docs"
      ],
      "options": {
        "outputPath": "dist/libs/cockpit-docs",
        "main": "libs/cockpit-docs/src/index.ts",
        "tsConfig": "libs/cockpit-docs/tsconfig.lib.json"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "configFile": "libs/cockpit-docs/vite.config.mts"
      }
    }
  },
  "tags": [
    "scope:cockpit",
    "scope:cockpit-deploy-smoke",
    "scope:cockpit-e2e",
    "scope:cockpit-examples"
  ]
}
